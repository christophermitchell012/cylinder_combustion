# Quasi-steady Pt(111) CO oxidation using the CatMAP tutorial energetics.
scaler = 'ThermodynamicScaler'
rxn_expressions = [
    '*_s + CO_g -> CO*',
    '2*_s + O2_g <-> O-O* + *_s -> 2O*',
    'CO* + O* <-> O-CO* + * -> CO2_g + 2*',
]
surface_names = ['Pt']
descriptor_names = ['temperature', 'logPressure']
# Effective reactive partial pressure in bar; remaining gas is inert.
descriptor_ranges = [[300, 930], [-7, -1.5]]
resolution = [43, 12]
species_definitions = {
    'CO_g': {'concentration': 2/3},
    'O2_g': {'concentration': 1/3},
    'CO2_g': {'concentration': 0},
    's': {'site_names': ['111'], 'total': 1},
}
input_file = 'energies.txt'
data_file = 'pt.pkl'
gas_thermo_mode = 'shomate_gas'
adsorbate_thermo_mode = 'frozen_adsorbate'
decimal_precision = 75
tolerance = 1e-40
max_rootfinding_iterations = 100
max_bisections = 3
